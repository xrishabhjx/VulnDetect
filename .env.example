# GitHub Personal Access Token (https://github.com/settings/tokens)
# Needs 'repo' scope for reading repository contents and metadata
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NIST NVD API Key (https://nvd.nist.gov/developers/request-an-api-key)
# Optional but recommended — increases rate limit from 5 to 50 requests per 30 seconds
NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Gemini API Key (https://aistudio.google.com/apikey)
# Required for text embeddings (text-embedding-004) and LLM reasoning (gemini-2.0-flash)
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Groq is the primary LLM reasoning provider. Gemini and heuristic reasoning are fallbacks.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# Optional overrides for Gemini reasoning and embeddings
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# API server port (the Next.js client defaults to this value)
PORT=3005
# Comma-separated browser origins permitted to call the API.
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Database URL (matches docker-compose.yml with pgvector)
DATABASE_URL=postgresql://vulnshield:vulnshield123@localhost:5433/vulnshield

# RSIS 5-Dimension Configurable Weights (Sum = 1.0)
# Grounded in: NIST SP 800-161, ISO/IEC 25010, CVSS v3.1 Spec
RSIS_WEIGHT_SECURITY=0.30
RSIS_WEIGHT_RETRIEVAL=0.20
RSIS_WEIGHT_VALIDATION=0.20
RSIS_WEIGHT_MAINTAINABILITY=0.15
RSIS_WEIGHT_COMPATIBILITY=0.15

# Evidence Strength Source Weights (Sum = 1.0)
# These are configurable defaults — not absolute truths.
# Tune via ablation experiments or expert weighting for your threat model.
# Example: set EVIDENCE_WEIGHT_GITHUB=0.35 if your org trusts GHSA advisories most.
EVIDENCE_WEIGHT_OSV=0.20
EVIDENCE_WEIGHT_NVD=0.20
EVIDENCE_WEIGHT_GITHUB=0.25
EVIDENCE_WEIGHT_KEV=0.20
EVIDENCE_WEIGHT_SIMILAR_REPO=0.15
